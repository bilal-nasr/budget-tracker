NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by scripts (owner:create, seed). Never import under src/.
SUPABASE_SECRET_KEY=
# Only used by `pnpm owner:create` to make an account without email. Sign-in is open to anyone with a confirmed account.
OWNER_EMAIL=
# Optional sub-path hosting, e.g. /budget (leave empty for root).
NEXT_PUBLIC_BASE_PATH=
# Public address of the app (used in confirmation emails and redirects). Set to your real https address in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional Cloudflare Turnstile bot check on sign-in and sign-up. Also enable captcha protection (Turnstile + secret) in the Supabase dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional SMTP for the "salary received" wallet summary email. Leave empty to turn the email off.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-character app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional sender, e.g. Budget Tracker <you@gmail.com>. Defaults to SMTP_USER.
SMTP_FROM=
